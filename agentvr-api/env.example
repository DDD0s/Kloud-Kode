# Per-host settings for the Kloud Kode API. Copy to "env" and edit.
# Every line is optional; the defaults work for a plain setup.
#
# This file is sourced by the shell, so quote any value containing spaces:
#   AGENTVR_BODY_NAME="my Windows desktop"

# Where Claude Code is, if it is not on PATH.
#CLAUDE_BIN=/home/you/.local/bin/claude
#NODE_BIN=/home/you/.nvm/versions/node/v22/bin/node

# Listen address. Add a second entry to also serve another port, e.g.
# AGENTVR_API_HOST=127.0.0.1,127.0.0.1:8317
#AGENTVR_API_HOST=127.0.0.1
#AGENTVR_API_PORT=18888

# Outbound proxy for Claude Code, if this host needs one. Leave unset if not.
#HTTPS_PROXY=http://127.0.0.1:7890
#HTTP_PROXY=http://127.0.0.1:7890
#NO_PROXY=127.0.0.1,localhost,::1,*.ts.net,100.64.0.0/10

# How the workstation is described to Claude, and the MCP server name in .mcp.json.
#AGENTVR_BODY_NAME="my Windows desktop"
#AGENTVR_BODY_MCP=komputer_use

# Working note appended to Claude Code's system prompt. It only says where the
# user's files and shell are. Replace it, or set it empty for no note at all:
#AGENTVR_SYSTEM_PROMPT=""

# The body, as ssh sees it (used by agentvr/tunnel-up.sh).
#BODY_SSH=body
#LOCAL_PORT=18787
#BODY_PORT=8787

# Health probe for the body, and the script that revives the tunnel.
#AGENTVR_HEALTH_URL=http://127.0.0.1:18787/healthz
#AGENTVR_TUNNEL_UP=/path/to/agentvr/tunnel-up.sh
# Set to 1 when the brain and the body are the same machine.
#AGENTVR_SKIP_TUNNEL=0

# Island mode (L2) is on by default: --tools "" removes all built-in tools.
#AGENTVR_BUILTIN_TOOLS=default
# Empty non-git dir for claude's cwd, e.g. /tmp/kloud-cwd (default: session dir).
#AGENTVR_CLAUDE_CWD=/tmp/kloud-cwd
# Experimental full system-prompt replacement. Evaluate on the brain first.
#AGENTVR_SYSTEM_PROMPT_FILE=/path/to/island-prompt.txt
